package com.papa.canaleschilenos.model

/**
 * Representa un canal de televisión.
 * nombre: lo que ve el usuario en la lista.
 * url: el link directo al archivo .m3u8 de ese canal.
 * logoUrl: link a una imagen del logo del canal (puede quedar null si no tienes uno).
 * categoria: para agruparlo en el menú horizontal (ej: "Chile", "Deporte", "Noticias").
 */
data class Channel(
    val nombre: String,
    val url: String,
    val logoUrl: String? = null,
    val categoria: String = "Chile"
)

